# Clerk Dashboard → Grava Simples → API keys → Publishable key.
# Copy this file to .env.local, or use the Clerk CLI as described in README.md.
VITE_CLERK_PUBLISHABLE_KEY=

# PostHog public project token (never a personal/admin API key).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_DEPLOYMENT_ENVIRONMENT=development
# Local telemetry is off by default. Enable only for analytics testing.
VITE_POSTHOG_ENABLED=false
# Server-side product analytics, errors, logs and traces use the same project.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Build-only source-map upload credentials, stored as sensitive Vercel variables.
# Prefer a personal API key scoped to this project with error_tracking:write.
POSTHOG_CLI_TOKEN=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://us.posthog.com

# Server-only transcription settings. Never add the VITE_ prefix to credentials.
# Configure these on Vercel; see docs/VERCEL_TRANSCRIPTION.md.
CLERK_SECRET_KEY=
# Alternatively use Clerk's public JWT verification key:
CLERK_JWT_KEY=
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-2
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
