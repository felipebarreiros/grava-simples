{
  "name": "grava-simples-experiment",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "node scripts/package-source.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/posthog-sourcemaps.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "build:engine": "bash scripts/build-obs-wasm.sh",
    "package:source": "node scripts/package-source.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:integration": "playwright test",
    "test:auth:live": "playwright test --config tests/auth-live.config.ts",
    "build:export": "bash scripts/build-export-wasm.sh && node scripts/package-export-source.mjs",
    "package:export-source": "node scripts/package-export-source.mjs",
    "test:transcription": "node --test --test-concurrency=1 tests/transcription*.test.mjs tests/transcript.test.mjs tests/cloud-transcription.test.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@clerk/localizations": "^4.24.3",
    "@clerk/react": "^6.18.3",
    "@clerk/ui": "^1.42.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@upstash/redis": "^1.40.0",
    "@vercel/blob": "^2.8.2",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "posthog-js": "^1.444.0",
    "posthog-node": "^5.61.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.53",
    "@playwright/test": "1.64.1",
    "@posthog/cli": "^0.19.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/node": "^29.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@posthog/cli@0.19.0": true
  }
}
